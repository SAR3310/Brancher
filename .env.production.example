# Brancher - Production Environment Configuration
# File ini adalah TEMPLATE untuk production deployment
# 
# INSTRUKSI:
# 1. Salin file ini menjadi ".env" di server production
# 2. Ganti SEMUA nilai dengan nilai real
# 3. Jangan upload .env ke GitHub (sudah di .gitignore)
# 4. Simpan backup .env di tempat aman

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Port yang server listening
# Catatan: Di production, biasanya reverse proxy (nginx) di port 80/443
# dan forward ke port ini (contoh: 3000). Jarang ubah ini.
PORT=3000

# Environment mode - WAJIB "production" di deployment!
# development = debug logs + allow localhost CORS
# production = optimize, secure cookies, trust proxy
NODE_ENV=production

# ============================================================
# SECURITY - CRITICAL
# ============================================================

# Session Secret - RANDOM STRING untuk encrypt session cookies
# WAJIB diganti! Generate baru dengan:
#   Linux/Mac: openssl rand -hex 32
#   Windows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Copy output (32 karakter hex) dan paste di sini
SESSION_SECRET=GANTI_INI_DENGAN_RANDOM_32_KARAKTER_HEX

# ============================================================
# CORS - Cross-Origin Requests
# ============================================================

# Domain yang boleh akses Brancher (comma-separated)
# Contoh:
#   Single domain: https://brancher.example.com
#   Multiple: https://brancher.example.com,https://www.brancher.example.com
#   Subdomain: https://chat.sekolah.sch.id
#
# PENTING: Include HTTPS dan domain yang benar!
# Kalau salah, frontend nggak bisa komunikasi backend
CORS_ORIGINS=https://brancher.example.com

# ============================================================
# DATA & FILES
# ============================================================

# Folder penyimpanan database SQLite + upload files
# 
# Rekomendasi:
#   - Linux: /var/lib/brancher/data atau /opt/brancher/data
#   - Windows: D:\brancher\data (disk terpisah untuk backup)
#   - Docker: /data (mount sebagai volume)
#
# PENTING: Folder ini harus:
#   ✓ Writable (permission 755)
#   ✓ Backup regular (daily dump)
#   ✓ Terpisah dari kode app (agar update kode nggak hilangkan data)
#
# Contoh Linux: /srv/brancher/data
# Contoh Windows: C:\brancher\data
DATA_DIR=/srv/brancher/data

# ============================================================
# LOGGING & MONITORING
# ============================================================

# Log level untuk console + file
# Pilihan: debug, info, warn, error
# 
# Rekomendasi production: warn (hanya warning + error)
# Catatan: Semua logs disimpan ke logs/ folder (jangan lupa backup!)
LOG_LEVEL=warn

# Optional: Sentry DSN untuk error tracking
# Kalau kosong, error hanya di logs file
# Sentry membantu capture bug di production
# Daftar gratis di https://sentry.io/
# Format: https://[email protected]/project_id
# SENTRY_DSN=

# ============================================================
# BACKUP & MAINTENANCE (opsional tapi recommended)
# ============================================================

# Folder untuk backup database (auto backup script)
# Jangan lupa backup ini juga ke cloud/external disk!
# BACKUP_DIR=/srv/brancher/backups

# ============================================================
# TLS/SSL - HTTPS Configuration (opsional, biasanya reverse proxy handle)
# ============================================================

# Kalau Brancher langsung handle TLS (tidak recommend, gunakan reverse proxy)
# TLS_CERT=/etc/letsencrypt/live/brancher.example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/brancher.example.com/privkey.pem

# ============================================================
# CHECKLIST SEBELUM DEPLOY
# ============================================================
# ✓ SESSION_SECRET di-generate random (bukan contoh)
# ✓ CORS_ORIGINS sesuai domain kamu
# ✓ DATA_DIR folder sudah dibuat dan writable
# ✓ NODE_ENV=production
# ✓ .env file simpan di /opt/brancher/.env (jangan di /home/user/)
# ✓ File permission: chmod 600 .env (hanya owner bisa baca)
# ✓ Backup strategy sudah direncanakan
# ✓ HTTPS/reverse proxy sudah setup
