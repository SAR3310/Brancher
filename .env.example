# Salin file ini jadi ".env" atau set di dashboard hosting
# SECURITY: Ganti semua nilai default sebelum deploy ke production!

# Port server (hosting biasanya set otomatis)
PORT=3000

# CRITICAL: Session secret untuk enkripsi session cookie
# WAJIB diganti dengan teks acak panjang (32+ karakter) di produksi!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang

# Folder penyimpanan database + upload.
# Di hosting: arahkan ke persistent disk/volume, mis. /data
DATA_DIR=./data

# Set "production" saat deploy (mengaktifkan secure cookie & trust proxy)
NODE_ENV=development

# CORS Origins (comma-separated, untuk production)
# Contoh: CORS_ORIGINS=https://brancher.example.com,https://www.brancher.example.com
# Default (development): localhost origins allowed
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Optional: Sentry error tracking DSN (for production)
# SENTRY_DSN=https://...@sentry.io/...
