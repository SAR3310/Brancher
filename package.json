{
  "name": "brancher",
  "version": "0.1.0",
  "description": "Brancher - platform komunitas berbasis Branch",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "postinstall": "cd client && npm install",
    "lint": "eslint server/ client/src/",
    "lint:fix": "eslint server/ client/src/ --fix",
    "format": "prettier --write \"server/**/*.js\" \"client/src/**/*.{js,jsx}\" \"*.md\"",
    "format:check": "prettier --check \"server/**/*.js\" \"client/src/**/*.{js,jsx}\" \"*.md\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-sqlite3": "^0.9.15",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "multer": "^2.0.0",
    "nanoid": "^3.3.7",
    "sentry-node": "^2.3.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
